{
  "name": "StrongEntry",
  "description": "The definition of a Strong's number, kept in the app so a reader can open the same word again without waiting for a live request.",
  "fields": [
    { "name": "code", "type": "string", "required": true, "label": "Strong's number" },
    { "name": "language", "type": "string", "label": "Greek or Hebrew" },
    { "name": "original_word", "type": "string", "label": "Original word" },
    { "name": "transliteration", "type": "string", "label": "Transliteration" },
    { "name": "pronunciation", "type": "string", "label": "Pronunciation" },
    { "name": "part_of_speech", "type": "string", "label": "Part of speech" },
    { "name": "root_word", "type": "string", "label": "Root word" },
    { "name": "definition", "type": "string", "label": "Definition" },
    { "name": "source", "type": "string", "label": "Source" }
  ],
  "x-fse2-access": {
    "version": 1,
    "rules": [
      { "actions": ["read"], "subject": { "roles": ["*"] } },
      { "actions": ["create", "update", "delete"], "subject": { "roles": ["owner", "admin"] } }
    ]
  }
}