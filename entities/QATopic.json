{
  "name": "QATopic",
  "description": "A topic of the Q&A library, with its English and Luganda name.",
  "fields": [
    { "name": "name_en", "type": "string", "required": true, "label": "Topic (English)" },
    { "name": "name_lu", "type": "string", "required": true, "label": "Topic (Luganda)" },
    { "name": "description_en", "type": "string", "label": "Description (English)" },
    { "name": "description_lu", "type": "string", "label": "Description (Luganda)" },
    { "name": "active", "type": "boolean", "label": "Active" }
  ],
  "x-fse2-access": {
    "version": 1,
    "rules": [
      { "actions": ["read"], "subject": { "roles": ["*"] } },
      { "actions": ["create", "update", "delete"], "subject": { "roles": ["owner", "admin"] } }
    ]
  }
}