{
  "name": "CrossReference",
  "description": "A cross-reference written for one verse: the verse the reader is on and the verse it points to, with the text of that verse kept with it.",
  "fields": [
    {"name": "book_number", "type": "number", "required": true, "label": "Book number (1..66)"},
    {"name": "chapter", "type": "number", "required": true, "label": "Chapter"},
    {"name": "verse", "type": "number", "required": true, "label": "Verse the reader is on"},
    {"name": "ref_book_number", "type": "number", "required": true, "label": "Book the reference points to"},
    {"name": "ref_chapter", "type": "number", "required": true, "label": "Chapter the reference points to"},
    {"name": "ref_verse", "type": "number", "required": true, "label": "Verse the reference points to"},
    {"name": "ref_verse_end", "type": "number", "label": "Last verse of the range the reference covers"},
    {"name": "ref_text_en", "type": "string", "label": "Text of the verse (EN)"},
    {"name": "ref_text_lu", "type": "string", "label": "Text of the verse (LU)"},
    {"name": "note_en", "type": "string", "label": "Note (EN)"},
    {"name": "note_lu", "type": "string", "label": "Note (LU)"},
    {"name": "source", "type": "string", "label": "Source"}
  ],
  "x-fse2-access": {
    "version": 1,
    "rules": [
      {"actions": ["read"], "subject": {"roles": ["*"]}},
      {"actions": ["create", "update", "delete"], "subject": {"roles": ["owner", "admin"]}}
    ]
  }
}