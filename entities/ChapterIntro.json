{
  "name": "ChapterIntro",
  "description": "The introduction written for one chapter of one book, in English and Luganda. Imported book by book from the prayer passage JSON files.",
  "fields": [
    {"name": "book_number", "type": "number", "required": true, "label": "Book number (1..66)"},
    {"name": "book_name", "type": "string", "label": "Book"},
    {"name": "chapter", "type": "number", "required": true, "label": "Chapter"},
    {"name": "title_en", "type": "string", "label": "Title (EN)"},
    {"name": "title_lu", "type": "string", "label": "Title (LU)"},
    {"name": "intro_en", "type": "string", "label": "Introduction (EN)"},
    {"name": "intro_lu", "type": "string", "label": "Introduction (LU)"},
    {"name": "source", "type": "string", "label": "Source"}
  ],
  "x-fse2-access": {
    "version": 1,
    "rules": [
      {"actions": ["read"], "subject": {"roles": ["*"]}},
      {"actions": ["create", "update", "delete"], "subject": {"roles": ["owner", "admin"]}}
    ]
  }
}